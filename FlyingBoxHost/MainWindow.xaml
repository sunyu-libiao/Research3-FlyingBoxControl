<Window x:Class="FlyingBoxHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FlyingBoxHost"
        mc:Ignorable="d"
        Title="FlyingBox 总线监视" Height="820" Width="1300"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <!-- 电机卡片 -->
        <DataTemplate x:Key="MotorTemplate">
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4"
                    Margin="4" Padding="8" Width="228" Background="#FAFAFA">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13"/>
                    <UniformGrid Columns="2" Margin="0,6,0,0">
                        <TextBlock Text="剩余主" Foreground="#777" FontSize="11"/>
                        <TextBlock Text="{Binding RemainMainText}" FontFamily="Consolas"/>
                        <TextBlock Text="剩余从" Foreground="#777" FontSize="11"/>
                        <TextBlock Text="{Binding RemainSubText}" FontFamily="Consolas"/>
                        <TextBlock Text="力矩" Foreground="#777" FontSize="11"/>
                        <TextBlock Text="{Binding Torque}" FontFamily="Consolas"/>
                        <TextBlock Text="位置" Foreground="#777" FontSize="11"/>
                        <TextBlock Text="{Binding PositionText}" FontFamily="Consolas"/>
                        <TextBlock Text="温度" Foreground="#777" FontSize="11"/>
                        <TextBlock Text="{Binding TemperatureText}" FontFamily="Consolas"/>
                        <TextBlock Text="状态" Foreground="#777" FontSize="11"/>
                        <TextBlock Text="{Binding StatusText}" FontFamily="Consolas"/>
                        <TextBlock Text="心跳" Foreground="#777" FontSize="11"/>
                        <TextBlock Text="{Binding Heartbeats}" FontFamily="Consolas"/>
                        <TextBlock Text="ACK" Foreground="#777" FontSize="11"/>
                        <TextBlock Text="{Binding Acks}" FontFamily="Consolas"/>
                        <TextBlock Text="帧数" Foreground="#777" FontSize="11"/>
                        <TextBlock Text="{Binding Frames}" FontFamily="Consolas"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 激光测距卡片 -->
        <DataTemplate x:Key="TofTemplate">
            <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4"
                    Margin="4" Padding="8" Width="228" Background="#F5F8FF">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13"/>
                    <UniformGrid Columns="2" Margin="0,6,0,0">
                        <TextBlock Text="距离" Foreground="#777" FontSize="11"/>
                        <TextBlock Text="{Binding DistanceText}" FontFamily="Consolas" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="原始值" Foreground="#777" FontSize="11"/>
                        <TextBlock Text="{Binding RawText}" FontFamily="Consolas" FontSize="11"/>
                        <TextBlock Text="序号" Foreground="#777" FontSize="11"/>
                        <TextBlock Text="{Binding Seq}" FontFamily="Consolas"/>
                        <TextBlock Text="频率" Foreground="#777" FontSize="11"/>
                        <TextBlock Text="{Binding Frequency}" FontFamily="Consolas"/>
                        <TextBlock Text="分辨率" Foreground="#777" FontSize="11"/>
                        <TextBlock Text="{Binding Resolution}" FontFamily="Consolas"/>
                        <TextBlock Text="心跳" Foreground="#777" FontSize="11"/>
                        <TextBlock Text="{Binding Heartbeats}" FontFamily="Consolas"/>
                        <TextBlock Text="帧数" Foreground="#777" FontSize="11"/>
                        <TextBlock Text="{Binding Frames}" FontFamily="Consolas"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 连接栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <Button x:Name="ConnectButton" Content="打开设备" Width="90" Height="26"
                    Click="ConnectButton_Click"/>
            <TextBlock Text="端口" VerticalAlignment="Center" Margin="10,0,4,0"/>
            <ComboBox x:Name="PortBox" Width="90" Height="24" SelectedIndex="0"/>
            <Button Content="刷新" Width="50" Height="26" Margin="4,0,0,0" Click="RefreshPorts_Click"/>
            <TextBlock Text="波特率" VerticalAlignment="Center" Margin="10,0,4,0"/>
            <ComboBox x:Name="BitrateBox" Width="88" Height="24" SelectedIndex="0">
                <ComboBoxItem Content="1 Mbps"/>
                <ComboBoxItem Content="500 kbps"/>
                <ComboBoxItem Content="250 kbps"/>
                <ComboBoxItem Content="125 kbps"/>
                <ComboBoxItem Content="100 kbps"/>
                <ComboBoxItem Content="50 kbps"/>
            </ComboBox>
            <CheckBox x:Name="AutoRecoverBox" Content="自动重开通道" IsChecked="True"
                      VerticalAlignment="Center" Margin="10,0,0,0"
                      ToolTip="长时间无字节时自动重发 O。该固件渠道状态会跨会话保留，上次关过就需要重开"/>
            <Button Content="清空" Width="60" Height="26" Margin="10,0,0,0" Click="ClearButton_Click"/>
            <Button Content="导出 CSV" Width="80" Height="26" Margin="6,0,0,0" Click="ExportButton_Click"/>
        </StackPanel>

        <!-- 设备信息 -->
        <TextBlock x:Name="DeviceInfoText" Grid.Row="1" TextWrapping="Wrap"
                   Foreground="#555" Margin="0,0,0,6" Text="未连接"/>

        <!-- 电机 -->
        <GroupBox Grid.Row="2" Header="电机（设备号 7~11）" Padding="4" Margin="0,0,0,6">
            <ItemsControl x:Name="MotorPanel" ItemTemplate="{StaticResource MotorTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </GroupBox>

        <!-- 激光测距 -->
        <GroupBox Grid.Row="3" Header="激光测距（设备号 25~26）" Padding="4" Margin="0,0,0,6">
            <ItemsControl x:Name="TofPanel" ItemTemplate="{StaticResource TofTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </GroupBox>

        <!-- 电机控制：由上位机直接下发命令，不经过固件 -->
        <GroupBox Grid.Row="4" Header="电机控制（上位机下发）" Padding="4" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="马达号" VerticalAlignment="Center"/>
                <ComboBox x:Name="MotorIndexBox" Width="64" Height="24" Margin="6,0,0,0"
                          SelectedIndex="0" SelectionChanged="MotorIndexBox_SelectionChanged">
                    <ComboBoxItem Content="7"/>
                    <ComboBoxItem Content="8"/>
                    <ComboBoxItem Content="9"/>
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="11"/>
                </ComboBox>
                <TextBlock Text="位移 mm" VerticalAlignment="Center" Margin="14,0,4,0"/>
                <TextBox x:Name="MoveDistanceBox" Width="90" Height="24" Text="10"
                         VerticalContentAlignment="Center"
                         ToolTip="正负表示方向。内部乘 10 换成协议的 0.1 mm 单位"/>
                <CheckBox x:Name="ReverseBox" Content="方向反转" VerticalAlignment="Center" Margin="14,0,0,0"
                          ToolTip="对应 0x0316 的 bit7。必须与固件 s_defaultMotors 的 reverse 一致，否则电机会朝反方向走"/>
                <Button x:Name="InitMoveButton" Content="初始化并位移" Width="110" Height="26"
                        Margin="14,0,0,0" Click="InitMoveButton_Click"/>
                <TextBlock x:Name="CommandText" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="#555" Text="未下发过命令"/>
            </StackPanel>
        </GroupBox>

        <!-- 原始报文 -->
        <GroupBox Grid.Row="5" Header="原始报文（最近 200 条）" Padding="4">
            <DataGrid x:Name="FrameGrid" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      FontFamily="Consolas" FontSize="11">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Seq}" Width="60"/>
                    <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="90"/>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="110"/>
                    <DataGridTextColumn Header="数据" Binding="{Binding Data}" Width="150"/>
                    <DataGridTextColumn Header="解析" Binding="{Binding Text}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <StatusBar Grid.Row="6">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
